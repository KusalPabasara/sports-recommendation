[Unit]
Description=Sports Recommendation API (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sports-rec
ExecStart=/opt/sports-rec/venv/bin/uvicorn app.backend.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/sports-rec

[Install]
WantedBy=multi-user.target
